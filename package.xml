<?xml version="1.0"?>
<package format="2">
  <name>ria_lo</name>
  <version>1.0.0</version>
  <description>
    RIA-LO: LiDAR odometry with reliability-aware scan-to-map optimization
    and exact incremental data association.
  </description>

  <maintainer email="qfwang23@whu.edu.cn">Qifeng Wang</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>

  <build_depend>libceres-dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_export_depend>libceres-dev</build_export_depend>
  <build_export_depend>libeigen3-dev</build_export_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <exec_depend>libceres-dev</exec_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libpcl-all-dev</exec_depend>

  <export/>
</package>
